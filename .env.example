# LLM (gratuito em console.groq.com/keys)
GROQ_API_KEY=

# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ninoagent

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ninoagent
POSTGRES_USER=ninoagent
