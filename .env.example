# LLM — chaves de API
GROQ_API_KEY=           # console.groq.com/keys (gratuito)
OPENROUTER_API_KEY=     # openrouter.ai (necessário para WholesaleAgent e InsightAgent)
ANTHROPIC_API_KEY=      # opcional — fallback para chamadas diretas fora do OpenRouter

# LLM — modelos (editar aqui para trocar sem alterar código)
GROQ_MODEL=llama-3.1-8b-instant
WHOLESALE_MODEL=openrouter/google/gemini-2.5-flash
INSIGHT_MODEL=openrouter/anthropic/claude-sonnet-4-5

# WhatsApp (Evolution API — substituída pela Meta API oficial)
# EVOLUTION_API_URL=http://localhost:8081
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=ninoagent

# WhatsApp (Meta API oficial)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ninoagent
POSTGRES_USER=ninoagent
POSTGRES_PASSWORD=ninoagent

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ninoagent_conversas

# Redis
REDIS_URL=redis://localhost:6379

# LangFuse (opcional — monitoramento)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Google Drive
GOOGLE_SA_CREDENTIALS_PATH=credentials/google-drive-sa.json
GOOGLE_DRIVE_CATALOG_FOLDER_ID=

# Monitor (interface de monitoramento de conversas)
MONITOR_TOKEN=           # token de acesso — qualquer string longa e aleatória

# Negócio
LOJA_NOME=
LOJA_WHATSAPP=
GRUPO_LINK=
HORARIO_ATENDIMENTO=seg-sex 8h-18h
SESSION_TIMEOUT_MINUTES=30
